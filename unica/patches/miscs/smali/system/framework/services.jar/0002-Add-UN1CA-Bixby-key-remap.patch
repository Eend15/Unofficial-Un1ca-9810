From 18f2ff84ad8d8cdadd8b0a30bfb20f3aec3d2286 Mon Sep 17 00:00:00 2001
From: Eend15 <a@b.c>
Date: Mon, 13 Jul 2026 01:15:00 +0200
Subject: [PATCH] Dispatch Exynos9810 Bixby scan code through UN1CA selector

---
 .../server/policy/PhoneWindowManager.smali    | 143 ++++++++++++++++++
 1 file changed, 143 insertions(+)

diff --git a/smali_classes2/com/android/server/policy/PhoneWindowManager.smali b/smali_classes2/com/android/server/policy/PhoneWindowManager.smali
index e894aa5..315ead9 100644
--- a/smali_classes2/com/android/server/policy/PhoneWindowManager.smali
+++ b/smali_classes2/com/android/server/policy/PhoneWindowManager.smali
@@ -12706,6 +12706,36 @@
 
     move/from16 v3, p2
 
+    # Handle the Exynos9810 physical Bixby key by scan code so this does not
+    # depend on Samsung's assistant policy and never affects a normal camera key.
+    invoke-virtual {v2}, Landroid/view/KeyEvent;->getScanCode()I
+
+    move-result v0
+
+    const/16 v4, 0x2bf
+
+    if-ne v0, v4, :unica_bixby_passthrough
+
+    invoke-virtual {v2}, Landroid/view/KeyEvent;->getAction()I
+
+    move-result v0
+
+    if-nez v0, :unica_bixby_consume
+
+    invoke-virtual {v2}, Landroid/view/KeyEvent;->getRepeatCount()I
+
+    move-result v0
+
+    if-nez v0, :unica_bixby_consume
+
+    invoke-static {v1}, Lcom/android/server/policy/PhoneWindowManager;->unicaBixbyRemap(Lcom/android/server/policy/PhoneWindowManager;)Z
+
+    :unica_bixby_consume
+    const/4 v0, 0x0
+
+    return v0
+
+    :unica_bixby_passthrough
     invoke-virtual {v2}, Landroid/view/KeyEvent;->getKeyCode()I
 
     move-result v4
@@ -16884,6 +16914,113 @@
     return-void
 .end method
 
+.method static synthetic unicaBixbyRemap(Lcom/android/server/policy/PhoneWindowManager;)Z
+    .locals 7
+
+    const/4 v0, 0x0
+
+    # UN1CA Bixby-key remap: action 0=Bixby 1=Gemini 2=Camera
+    const-string v1, "persist.sys.unica.bixby_action"
+
+    invoke-static {v1, v0}, Landroid/os/SystemProperties;->getInt(Ljava/lang/String;I)I
+
+    move-result v3
+
+    iget-object v1, p0, Lcom/android/server/policy/PhoneWindowManager;->mContext:Landroid/content/Context;
+
+    invoke-virtual {v1}, Landroid/content/Context;->getPackageManager()Landroid/content/pm/PackageManager;
+
+    move-result-object v4
+
+    const/4 v5, 0x0
+
+    if-nez v3, :not_default
+
+    new-instance v5, Landroid/content/Intent;
+
+    const-string v6, "com.samsung.android.bixby.action.WAKEUP_LAUNCH_BIXBY"
+
+    invoke-direct {v5, v6}, Landroid/content/Intent;-><init>(Ljava/lang/String;)V
+
+    const-string v6, "com.samsung.android.bixby.agent"
+
+    invoke-virtual {v5, v6}, Landroid/content/Intent;->setPackage(Ljava/lang/String;)Landroid/content/Intent;
+
+    move-result-object v5
+
+    sget-object v2, Landroid/os/UserHandle;->CURRENT:Landroid/os/UserHandle;
+
+    invoke-virtual {v1, v5, v2}, Landroid/content/Context;->sendBroadcastAsUser(Landroid/content/Intent;Landroid/os/UserHandle;)V
+
+    const/4 v0, 0x1
+
+    return v0
+
+    :not_default
+    const/4 v6, 0x1
+
+    if-ne v3, v6, :not_gemini
+
+    const-string v6, "com.google.android.apps.bard"
+
+    invoke-virtual {v4, v6}, Landroid/content/pm/PackageManager;->getLaunchIntentForPackage(Ljava/lang/String;)Landroid/content/Intent;
+
+    move-result-object v5
+
+    if-nez v5, :have_intent
+
+    new-instance v5, Landroid/content/Intent;
+
+    const-string v6, "android.intent.action.VOICE_ASSIST"
+
+    invoke-direct {v5, v6}, Landroid/content/Intent;-><init>(Ljava/lang/String;)V
+
+    goto :have_intent
+
+    :not_gemini
+    const/4 v6, 0x2
+
+    if-ne v3, v6, :ret_false
+
+    new-instance v5, Landroid/content/Intent;
+
+    const-string v6, "android.media.action.STILL_IMAGE_CAMERA"
+
+    invoke-direct {v5, v6}, Landroid/content/Intent;-><init>(Ljava/lang/String;)V
+
+    :have_intent
+    if-eqz v5, :ret_false
+
+    const/high16 v2, 0x10000000
+
+    invoke-virtual {v5, v2}, Landroid/content/Intent;->addFlags(I)Landroid/content/Intent;
+
+    :try_start_0
+    sget-object v2, Landroid/os/UserHandle;->CURRENT:Landroid/os/UserHandle;
+
+    invoke-virtual {v1, v5, v2}, Landroid/content/Context;->startActivityAsUser(Landroid/content/Intent;Landroid/os/UserHandle;)V
+    :try_end_0
+    .catch Ljava/lang/Exception; {:try_start_0 .. :try_end_0} :catch_0
+
+    const/4 v0, 0x1
+
+    return v0
+
+    :catch_0
+    move-exception v1
+
+    const-string v1, "PhoneWindowManager"
+
+    const-string v2, "UN1CA Bixby remap failed to launch"
+
+    invoke-static {v1, v2}, Landroid/util/Log;->e(Ljava/lang/String;Ljava/lang/String;)I
+
+    :ret_false
+    const/4 v0, 0x0
+
+    return v0
+.end method
+
 .method public final launchAssistAction(IIJLjava/lang/String;)V
     .locals 2
 
-- 
2.43.0
