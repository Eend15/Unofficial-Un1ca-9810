#!/usr/bin/env python3
"""Accept natural double taps for double-tap-to-wake.

wake_gestures.c only paired two taps if their releases were < 500 ms apart and
< 150 units apart on each axis. The touch grid is 4096x4096 over a 1440x2960
panel, so 150 units is only ~2.5 mm sideways. A recorded S9+ session showed
real screen-off attempts with 666 ms and 734 ms between taps (rejected, user
had to retry) and natural double taps drifting up to 189 units sideways.
Widen the window to 700 ms and 250 units (~4 mm sideways, ~6 mm vertical).
"""
from pathlib import Path
import sys

MARKER = "UN1CA_DT2W_TAP_WINDOW"
FILE = "drivers/input/touchscreen/wake_gestures.c"
OLD = """#define DT2W_FEATHER		150
#define DT2W_TIME 		500
"""
NEW = f"""/* {MARKER}: 150 units/500 ms rejected natural screen-off double taps. */
#define DT2W_FEATHER		250
#define DT2W_TIME 		700
"""


def transform(text):
    if MARKER in text:
        if text.count(NEW) != 1:
            raise ValueError("wake_gestures: tap window marker without the full fix")
        return text
    if text.count(OLD) != 1:
        raise ValueError("Unknown wake_gestures.c: DT2W_FEATHER/DT2W_TIME not found")
    return text.replace(OLD, NEW, 1)


if __name__ == "__main__":
    path = Path(sys.argv[1]) / FILE
    path.write_text(transform(path.read_text()))
    print("PASS double-tap-to-wake accepts natural tap spacing")
