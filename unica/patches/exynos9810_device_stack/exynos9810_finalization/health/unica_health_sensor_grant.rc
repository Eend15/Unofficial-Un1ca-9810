on property:sys.boot_completed=1 && property:sys.user.0.ce_available=true
    start unica_health_sensor_grant

service unica_health_sensor_grant /system/bin/sh /system/bin/unica_health_sensor_grant.sh
    class late_start
    user root
    group root system shell
    disabled
    oneshot
    seclabel u:r:su:s0
