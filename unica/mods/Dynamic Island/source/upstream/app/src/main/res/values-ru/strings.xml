    <string name="setting_card_header">Заголовок карточки</string>
    <string name="setting_card_header_desc">Показывать название приложения и время над карточками живых уведомлений.</string>
    <string name="setting_color_icons">Исходные цвета компактных значков</string>
    <string name="setting_shade_media">Музыкальный плеер в шторке</string>
