 "external_device_name_patterns": [
  "(?<![a-z])(?:connected|connecting|pair(?:ed|ing))\\s*(?:to)?\\s*[\"«]?([\\p{L}\\p{N}][\\p{L}\\p{N} ._#\\-]{1,40})[\"»]?(?=\\s|$|[,.!])",
  "[\"«]?([\\p{L}\\p{N}][\\p{L}\\p{N} ._#\\-]{1,40})[\"»]?\\s*(?:이\\(가\\)|이|가)?\\s*연결(?:됨|되었습니다)"
 ],
 "otp_strong_triggers": [
  "본인확인 인증번호",
  "로그인 코드",
  "인증 코드",
  "일회용 비밀번호"
 ],
 "text_progress_include_context_pattern": "(다운로드 중|다운로드 진행|진행도|progress|파일 조각|오프라인 지도|리소스)",
 "text_progress_exclude_context_pattern": "(관세|금리|할인율|수수료|정확도|득점)",
 "navigation_distance_pattern": "(\\d+(?:[.,]\\d+)?\\s?(?:km|m(?![a-z])|킬로미터|미터))"
}
