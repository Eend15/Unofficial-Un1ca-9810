    <string name="app_name" translatable="false">Dynamic Island</string>
    <string name="xposed_description">Dynamic Island in the style of ColorOS / HyperOS: replaces the One UI Now Bar status bar capsule.</string>
    <string name="settings_hint">Enable the module for System UI in LSPosed. Changes apply within a few seconds.</string>
    <string name="setting_card_header">Card header</string>
    <string name="setting_card_header_desc">Show the app name and time above live notification cards.</string>
    <string name="setting_color_icons">Original compact icon colours</string>
    <string name="setting_shade_media">Music player in the shade</string>
    <string name="setting_shade_media_desc">Show the island music card in the notification panel.</string>
    <string name="setting_color_icons_desc">Keep app and team icon colours in the compact island.</string>
    <string name="setting_visualizer">Audio waveform</string>
    <string name="setting_visualizer_desc">Drive the music waveform from the real audio output. Off uses a gentle animation instead.</string>
    <string name="setting_paused_timeout">Keep paused music for</string>
    <string name="setting_auto_collapse">Manually opened card auto-collapse</string>
    <string name="setting_event_charging">Charging &amp; low battery</string>
    <string name="setting_event_charging_desc">Pop up when a charger is plugged in and when the battery runs low.</string>
    <string name="setting_event_ringer">Sound mode</string>
    <string name="setting_event_ringer_desc">Show Silent / Vibrate / Ring when the sound mode changes.</string>
    <string name="setting_event_bluetooth">Bluetooth audio</string>
    <string name="setting_event_bluetooth_desc">Show headphones and speakers when they connect, with their battery level.</string>
    <string name="setting_haptics">Haptic feedback</string>
    <string name="setting_haptics_desc">A light tick when the island expands or collapses and a click on its buttons.</string>
    <string name="setting_privacy">Privacy usage indicators</string>
    <string name="setting_privacy_desc">Master switch for camera, microphone and optional location indicators.</string>
    <string name="setting_privacy_location">Location in use</string>
    <string name="setting_privacy_location_desc">Also announce location use. Off by default: navigation and weather apps use it constantly.</string>
    <string name="setting_event_toggles">Setting changes</string>
    <string name="setting_event_toggles_desc">Confirm Do Not Disturb, airplane mode, power saving, flashlight, hotspot and auto-rotate being switched.</string>
    <string name="setting_torch_pill">Flashlight card</string>
    <string name="setting_torch_pill_desc">While the flashlight is on, show it on the island with a button to turn it off. Works on phones whose flashlight has a single brightness level too.</string>
    <string name="setting_progress">Downloads &amp; transfers</string>
    <string name="setting_hide_progress">Hide original progress notifications</string>
    <string name="setting_hide_progress_desc">Hide the original while its progress card is on the island.</string>
    <string name="setting_progress_desc">Show ongoing notifications with a progress bar (downloads, file copies, app updates) as cards.</string>
    <string name="setting_heads_up">Notifications in the island</string>
    <string name="setting_all_notifications">All notifications in the island</string>
    <string name="setting_all_notifications_desc">Every new notification gets an island card, also the quiet ones that would not pop up as a banner. Ongoing, call and alarm notifications and the app you are in are left out. Experimental: it may not work on every phone or for every app.</string>
    <string name="setting_heads_up_desc">Messages and other banner notifications appear as an island card instead of the heads-up banner. Calls and alarms keep the stock banner.</string>
    <string name="setting_otp">Verification codes</string>
    <string name="setting_otp_desc">A text with a verification code opens a card with the code and a Copy button.</string>
    <string name="setting_otp_copy">Copy codes automatically</string>
    <string name="setting_otp_copy_desc">Put the code on the clipboard as soon as the card appears (replaces what you copied before).</string>
    <string name="setting_calls">Voice-chat calls</string>
    <string name="setting_calls_desc">Ongoing calls of voice-chat and VoIP apps get the call card with the running time and an end button.</string>
    <string name="restart_systemui">Restart System UI</string>
    <string name="restart_systemui_confirm">The status bar and notification shade restart for a moment so the module reloads. Needs root.</string>
    <string name="restart_systemui_failed">Could not restart System UI. Root access was not granted; restart it from the LSPosed manager or reboot.</string>
    <string name="rules_title">Notification auto-classification</string>
    <string name="rules_about">Classify notification text into activity cards. Detection depends on the app and wording. Turn off a card type if it causes incorrect matches; edit patterns in the advanced rule editor.</string>
    <string name="setting_smart_rules">Delivery, ride, route and device cards</string>
    <string name="setting_smart_rules_desc">Turn notifications that say \"the rider is almost there\" into a card with the stage they report.</string>
