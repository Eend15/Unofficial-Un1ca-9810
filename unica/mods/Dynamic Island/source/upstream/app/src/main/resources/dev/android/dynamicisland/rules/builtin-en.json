    "com.jbl"
   ],
   "exclude_patterns": [
    "(software update|firmware|update available|backup|tips? (and|&)|user guide|screenshot|new feature|setup|set up)",
    "(not (nearby|near|in range)|out of range)"
   ],
   "signals": [
    {
     "stage": 3,
     "pattern": "(charging complete|fully charged|battery (is )?full|finished charging|(is )?(?<![a-z])charged)"
    },
    {
     "stage": 2,
     "pattern": "((is )?(now )?(?<!dis)(?<!not )(?<!n't )(re)?connected|connected to your phone|reconnected|back online|(is )?online)"
    },
    {
     "stage": 0,
     "pattern": "((is )?(now )?disconnected|not connected|lost connection|connection lost|(is )?offline|(has )?disconnected)"
    }
   ],
   "cooldown_min": 15
  },
  {
   "id": "battery",
   "max_stage": 1,
   "ttl_min": 15,
   "package_hints": [
    "com.google.android.apps.wearables",
    "com.samsung.android.app.watchmanager",
    "com.fitbit",
    "com.garmin.android.apps.connectmobile",
    "com.oculus",
    "com.jabra",
    "com.bose",
    "com.jbl"
   ],
   "signals": [
    {
     "stage": 1,
     "pattern": "(?:battery|charge)[^%\\d]{0,24}?(?:low|critical|at|is|left)[^%\\d]{0,12}?(?<!\\d)(20|1\\d|\\d)(?!\\d)\\s*%",
     "percent_group": 1
    },
    {
     "stage": 1,
     "pattern": "(?<!\\d)(20|1\\d|\\d)(?!\\d)\\s*%\\s*(?:battery\\s*)?(?:remaining|left)",
     "percent_group": 1
    },
    {
     "stage": 1,
     "pattern": "low battery[^%\\d]{0,24}?(\\d{1,3})\\s*%",
     "percent_group": 1
    }
   ],
   "cooldown_min": 20
  },
  {
