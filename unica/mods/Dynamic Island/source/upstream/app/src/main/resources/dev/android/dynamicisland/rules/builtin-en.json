    "com.evri",
    "com.parcelforce",
    "com.yodel",
    "com.dpd",
    "com.gls",
    "com.postnl",
    "com.canadapost",
    "com.auspost",
    "com.tracktry",
    "com.parcel"
   ],
   "exclude_patterns": [
    "(sale|deal|coupon|promo|discount|% off|offer|save \\$|reward)",
    "(rate your|leave a review|review (your|this)|survey|how was)",
    "(return (label|request|window)|refund|cancel+ed)",
    "(prime (day|video|music)|membership|subscription)"
   ],
   "signals": [
    {
     "stage": 4,
     "pattern": "((was|has been|have been|been) delivered|delivered( to| at| in| on|:)|left (at|in|on|by) (your |the )?(front door|door|mailbox|porch|lobby|reception|doorstep|garage|neighbou?r)|delivery (is )?complete|ready for pickup at)"
    },
    {
     "stage": 3,
     "pattern": "(out for delivery|arriving (today|tomorrow|soon|now|by)|will be delivered (today|tomorrow)|delivery (is )?(scheduled )?(for )?today|(driver|courier|carrier) (is )?(nearby|\\d+ stops? away|on the way)|delivering (today|your))"
    },
    {
     "stage": 2,
     "pattern": "(arrived at (a |the |your |our )?(local |regional |destination |nearest |sort(ing)? |distribution |delivery )?(facility|hub|post office|depot|center|centre|warehouse)|at (the )?local (facility|post office|delivery)|reached (your )?(local|nearest))"
    },
    {
     "stage": 1,
     "pattern": "((has|have) shipped|(order|package|parcel|item)s? (has |have )?(been )?shipped|shipped( on|:)?|in transit|(departed|left|leaving) (the |our |a )?(origin |sort(ing)? )?(facility|hub|warehouse|location)|processed (at|through)|on (its|the) way)"
    },
    {
     "stage": 0,
     "pattern": "(label (has been )?created|shipment (information )?(received|created)|order (has been )?(received|confirmed|placed)|preparing (your )?(shipment|package|order)|(awaiting|waiting for) (pickup|shipment|carrier))"
    }
   ]
  },
  {
   "id": "taxi",
   "max_stage": 4,
   "final_ttl_min": 5,
   "package_hints": [
    "com.ubercab",
    "com.lyft.android",
    "me.lyft",
    "com.bolt",
    "ee.mtakso",
    "com.grabtaxi.passenger",
