    "com.glovo",
    "com.yum.",
    "com.subway",
    "com.mcdonalds",
    "com.panera",
    "com.chickfila",
    "com.tacobell"
   ],
   "exclude_patterns": [
    "(promo|coupon|discount|% off|\\$\\d+ off|free delivery|deal|offer|reward|earn|points|save \\$|gift card)",
    "(rate your|how was|leave a review|feedback|survey)",
    "(add a tip|tip your|\\btipping\\b)",
    "(refund|cancel+ed|unable to|issue with|missing item|substitut)"
   ],
   "signals": [
    {
     "stage": 4,
     "pattern": "(has been delivered|was delivered|been delivered|order (has )?arrived|enjoy your (meal|order|food)|delivered (to|at) (your )?(door|address|location|building))"
    },
    {
     "stage": 3,
     "pattern": "(arriving (now|soon|shortly|in \\d+)|almost (there|here)|(is|are) (nearby|outside|close|at your (door|location))|will be there in \\d+|just around the corner|ready for pickup|ready to pick up|order is ready|is ready for you)"
    },
    {
     "stage": 2,
     "pattern": "(on (the|its|their) way|(picked up|picking up) your (order|food)|out for delivery|heading (to you|your way|to your (location|address))|(has|have) (picked up|left the restaurant)|(is|are) delivering)"
    },
    {
     "stage": 1,
     "pattern": "((is|are|being) (preparing|prepared|making|made|cooking|packing) (your )?(order|food|meal)?|(restaurant|store|kitchen) (has )?(accepted|is preparing|is making|confirmed)|preparing your (order|food|meal)|your order is being prepared|looking for a (dasher|driver|courier))"
    },
    {
     "stage": 0,
     "pattern": "(order( from [^.!?\\n]{1,40})? (has been |is |was |has )?(placed|received|confirmed|submitted)|(we('| ha)ve|we) received your order|thanks for your order|thank you for your order|order confirmed)"
    }
   ]
  },
  {
   "id": "parcel",
