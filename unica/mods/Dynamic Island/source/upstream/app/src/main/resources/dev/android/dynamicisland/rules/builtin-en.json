    "com.cabify",
    "com.yandex.taxi",
    "com.inDriver",
    "sinet.startup.indriver"
   ],
   "exclude_patterns": [
    "(promo|coupon|discount|% off|free ride|offer|reward|gift|invite|refer)",
    "(schedule(d)? (a )?ride|reserve)",
    "(safety check|share (your )?trip)"
   ],
   "signals": [
    {
     "stage": 4,
     "pattern": "((you('| ha)ve|you) arrived|have arrived (at|to) (your )?destination|(trip|ride) (has )?(ended|completed|is complete)|(your )?(trip|ride) is complete|thanks for riding|dropped off|rate your (driver|ride|trip))"
    },
    {
     "stage": 3,
     "pattern": "((driver|ride|car|cab) (has |is )?(arrived|here|waiting)|(has )?arrived (at|to) (your )?(pickup|location)|(is )?(waiting|outside) (for you|at)|meet your driver|on your way to|heading to (your )?destination|enjoy your (ride|trip))"
    },
    {
     "stage": 2,
     "pattern": "((driver|ride|car|cab) (is )?(on (the|their) way|arriving|\\d+ min(utes)? away|coming|approaching)|arriving in \\d+|(is )?\\d+ min(utes)? away|heading (to you|your way|to your (pickup|location)))"
    },
    {
     "stage": 1,
     "pattern": "((driver|ride|trip|request) (has been |was |is )?(accepted|confirmed|assigned|matched)|matched with|(your )?(driver|ride) (is )?confirmed|driver (accepted|assigned))"
    },
    {
     "stage": 0,
     "pattern": "((finding|looking for|searching for|connecting you to) (a |your )?(driver|ride|car|cab)|requesting (a |your )?(ride|car)|waiting for (a )?driver)"
    }
   ]
  },
  {
   "id": "navigation",
