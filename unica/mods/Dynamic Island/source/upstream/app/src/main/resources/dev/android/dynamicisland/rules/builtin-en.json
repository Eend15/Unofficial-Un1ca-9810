   ],
   "exclude_patterns": [
    "(timeline|review|photos?|contribut|\\brate\\b|explore|places? (to|you)|reservation|\\btips?\\b|saved|your (trip|week|month)|mapping|popular|crowd)"
   ],
   "signals": [
    {
     "stage": 4,
     "pattern": "((you('| ha)ve|you) arrived|arriv(ed|ing) (at|to) (your )?destination|destination (is )?(on|ahead|reached)|navigation (has )?(ended|stopped|finished)|trip (has )?ended)"
    },
    {
     "stage": 3,
     "pattern": "((get|getting) off (at|the|in)|exit (at|the|train|bus)|next stop|arriv(e|ing) (at|in) (the )?(next )?stop|your stop|alight)"
    },
    {
     "stage": 2,
     "pattern": "((board|take|ride) (the |a |an )?\\w+ (bus|train|tram|subway|metro|line|ferry)|(bus|train|tram|subway|metro|ferry|line) (to|towards|toward|at|from)|platform \\d+|transit)"
    },
    {
     "stage": 1,
     "pattern": "((head|turn|continue|keep|take|merge|bear|slight|sharp|make a|use the|follow|walk|cycle|drive|go) (north|south|east|west|left|right|straight|onto|on|to|along|for|toward)|navigation (has )?started|starting navigation|in \\d+(\\.\\d+)? ?(mi|miles?|km|m|ft|feet|yd)|\\d+ min (\\W )?\\d+(\\.\\d+)? ?(mi|km)|\\beta\\b)"
    }
   ]
  },
  {
   "id": "wearable",
   "max_stage": 3,
   "ttl_min": 3,
   "package_hints": [
    "com.samsung.android.app.watchmanager",
    "com.google.android.apps.wearables",
    "com.fitbit",
