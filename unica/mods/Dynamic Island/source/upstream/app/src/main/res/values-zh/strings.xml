    <string name="setting_card_header">卡片标题栏</string>
    <string name="setting_card_header_desc">在实时通知卡片上方显示应用名称和时间。</string>
    <string name="setting_color_icons">保留小图标原色</string>
    <string name="setting_shade_media">通知栏音乐播放器</string>
    <string name="setting_shade_media_desc">在通知面板中显示灵动岛音乐卡片。</string>
    <string name="setting_color_icons_desc">在收起的灵动岛中保留应用和队伍图标的原色。</string>
    <string name="setting_visualizer">音频波形</string>
    <string name="setting_visualizer_desc">根据实际音频输出驱动波形。关闭后使用柔和的动画。</string>
