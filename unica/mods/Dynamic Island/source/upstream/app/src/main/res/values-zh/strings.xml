    <string name="setting_event_ringer">声音模式</string>
    <string name="setting_event_ringer_desc">切换声音模式时显示静音、振动或响铃状态。</string>
    <string name="setting_event_bluetooth">蓝牙音频</string>
    <string name="setting_event_bluetooth_desc">耳机或音箱连接时显示设备及其电量。</string>
    <string name="setting_haptics">触觉反馈</string>
    <string name="setting_haptics_desc">展开或收起时轻振，点击按钮时提供触感反馈。</string>
    <string name="setting_privacy">隐私使用指示器</string>
    <string name="setting_privacy_desc">统一控制相机、麦克风及可选的位置信息指示器。</string>
    <string name="setting_privacy_location">位置使用状态</string>
    <string name="setting_privacy_location_desc">同时提示位置访问。导航和天气应用会持续使用位置，因此默认关闭。</string>
    <string name="setting_event_toggles">设置变更</string>
    <string name="setting_event_toggles_desc">提示勿扰、飞行、省电、手电筒、热点和自动旋转的切换状态。</string>
    <string name="setting_torch_pill">手电筒卡片</string>
    <string name="setting_torch_pill_desc">手电筒开启时显示卡片及关闭按钮。仅支持单档亮度的设备也可使用。</string>
    <string name="setting_progress">下载与传输</string>
    <string name="setting_hide_progress">隐藏原始进度通知</string>
    <string name="setting_hide_progress_desc">灵动岛显示进度卡片时隐藏原始通知。</string>
    <string name="setting_progress_desc">将带进度条的持续通知（下载、文件复制、应用更新）显示为卡片。</string>
    <string name="setting_heads_up">岛内通知</string>
    <string name="setting_all_notifications">在岛内显示所有通知</string>
    <string name="setting_all_notifications_desc">将所有新通知（包括不弹横幅的静默通知）显示为卡片。不包括持续通知、通话、闹钟和正在使用的应用。实验功能，部分设备或应用可能不适用。</string>
    <string name="setting_heads_up_desc">将消息等横幅通知改为岛内卡片。通话和闹钟保留系统横幅。</string>
    <string name="setting_otp">验证码</string>
    <string name="setting_otp_desc">收到包含验证码的文本时，展开显示验证码和复制按钮的卡片。</string>
    <string name="setting_otp_copy">自动复制验证码</string>
    <string name="setting_otp_copy_desc">卡片出现时立即复制验证码，将替换剪贴板原有内容。</string>
    <string name="setting_calls">语音聊天通话</string>
    <string name="setting_calls_desc">为语音聊天和 VoIP 应用的进行中通话显示计时及挂断按钮。</string>
