ui_print("Writing Exynos9810 boot ramdisk...");
package_extract_file("exynos9810/ramdisk.img", "/dev/block/platform/11120000.ufs/by-name/BOOT");
ui_print("Installing Exynos9810 kernel zip...");
package_extract_file("exynos9810/kernel.zip", "/tmp/exynos9810/kernel.zip");
run_program("/sbin/mkdir", "-p", "/tmp/exynos9810/kernel");
run_program("/sbin/busybox", "unzip", "/tmp/exynos9810/kernel.zip", "META-INF/com/google/android/*", "-d", "/tmp/exynos9810/kernel") == 0 ||
    abort("E9810: Failed to extract kernel installer.");
run_program("/sbin/chmod", "-R", "0755", "/tmp/exynos9810/kernel");
run_program("/sbin/sh", "/tmp/exynos9810/kernel/META-INF/com/google/android/update-binary", getprop("ro.boot.bootloader"), "1", "/tmp/exynos9810/kernel.zip") == 0 ||
    abort("E9810: Failed to install Exynos9810 kernel.");
ui_print("Formatting cache, omr, preload and data...");
ifelse(is_mounted("/cache"), unmount("/cache"));
ifelse(is_mounted("/omr"), unmount("/omr"));
ifelse(is_mounted("/preload"), unmount("/preload"));
ifelse(is_mounted("/data"), unmount("/data"));
run_program("/sbin/sh", "/tmp/exynos9810/format_partitions.sh", "post_install") == 0 ||
    abort("E9810: Failed to format cache/omr/preload/data.");
