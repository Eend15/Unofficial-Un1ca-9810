    <!-- Dual camera features -->
    <!-- SUPPORT_SEAMLESS_ZOOM must stay true; N960F stock ships true and the
         legacy-port import wrongly set it false. ZoomController.getMaxZoomLevel()
         returns the current camera's zoom immediately when this is set. With it
         false it instead walks a telephoto branch that resolves BACK_TELE to
         device 21 (not the 50 declared below), and camera 21 reports
         samsung.android.scaler.availableMaxDigitalZoomList = [1.0, 10.0, 1.0].
         Photo mode uses ZoomType.NORMAL (list index 0), so max comes back 1.0
         which scales to 1000, equal to the 1000 minimum, and
         ZoomPresenter.getZoomShortcutCommandIdList() throws "Zoom is not
         supported" as soon as the back camera finishes its first preview.
         Confirmed on a Note9 dumpstate: "add capability(21)" is logged 4 ms
         before the fatal exception, and cameras 0/20/50 all report 10.0.
         Why BACK_TELE resolves to 21 rather than 50 is still unexplained; this
         restores the stock value that avoids the branch entirely. -->
    <local name="SUPPORT_BACK_DUAL_PORTRAIT" value="false"/>
    <local name="SUPPORT_SEAMLESS_ZOOM" value="true"/>
    <local name="SUPPORT_LIVE_FOCUS_DUAL_CAPTURE" value="false"/>
